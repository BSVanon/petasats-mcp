    "@types/mocha": "10.0.10",
    "@types/chai": "4.3.20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test mcp/tests/*.test.ts && node --import tsx build/test.mjs",
    "build": "node build/bundle.mjs",
    "smoke": "node dist/petasats-mcp.mjs --smoke",
    "verify": "node build/verify-package.mjs"
