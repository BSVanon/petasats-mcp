  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BSVanon/petasats-mcp.git"
  },
  "homepage": "https://github.com/BSVanon/petasats-mcp",
  "bugs": {
    "url": "https://github.com/BSVanon/petasats-mcp/issues"
  },
  "keywords": [
    "mcp",
    "bsv",
    "usdc",
    "base",
    "atomic-swap",
    "non-custodial"
  ],
  "mcpName": "io.github.BSVanon/petasats-mcp",
  "devDependencies": {
    "@bsv/sdk": "2.1.0",
    "@bsv/wallet-helper": "0.0.6",
    "@bsv/wallet-toolbox": "2.1.21",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "12.11.1",
    "chai": "4.5.0",
    "esbuild": "0.28.2",
    "knex": "3.3.0",
    "mocha": "12.0.0",
    "ts-node": "10.9.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "viem": "2.55.17",
